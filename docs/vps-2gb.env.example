# Small VPS profile: 1 CPU / 2 GB RAM / 30 GB disk.
# Copy to /opt/threaddock/shared/.env; fill BOT_TOKEN on the server only.
BOT_TOKEN=
DATA_DIR=/app/data
DOWNLOAD_WORKERS=1
QUEUE_CAPACITY=100
MAX_DOWNLOAD_MB=256
MAX_UPLOAD_MB=49
MIN_FREE_DISK_MB=2048
CACHE_MAX_MB=1024
CACHE_TTL_HOURS=24
ARCHIVE_STORAGE_MB=4096
ARCHIVE_MEDIA_DOWNLOAD_MB=20
ARCHIVE_HOST=0.0.0.0
ARCHIVE_PORT=8080
ARCHIVE_PUBLIC_URL=
ARCHIVE_DOMAIN=
ENABLE_BUSINESS=true
BUSINESS_ALLOWED_CHAT_IDS=
OPERATOR_IDS=
