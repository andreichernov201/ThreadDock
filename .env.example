# Токен бота из @BotFather. Скопируй этот файл в .env и заполни значение.
BOT_TOKEN=

# Исполняемые файлы должны быть в PATH; можно указать полный путь.
YTDLP_EXECUTABLE=yt-dlp
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
DENO_EXECUTABLE=deno

DATA_DIR=data
DOWNLOAD_WORKERS=2
QUEUE_CAPACITY=200
DOWNLOAD_TIMEOUT_SECONDS=300
# Each local extractor process has its own short deadline; queue owns retries.
EXTRACTOR_TIMEOUT_SECONDS=45
# Работа над каждой ссылкой, включая отправку; ожидание очереди не считается. Максимум 60 секунд.
REQUEST_TIMEOUT_SECONDS=60
PROCESS_TIMEOUT_SECONDS=300
DOWNLOAD_RETRIES=2
SHUTDOWN_TIMEOUT_SECONDS=30

# MAX_DOWNLOAD_MB, CACHE_MAX_MB и MIN_FREE_DISK_MB — МиБ; MAX_UPLOAD_MB — десятичные МБ.
MAX_DOWNLOAD_MB=500
MAX_UPLOAD_MB=49
MAX_DURATION_SECONDS=1800
MAX_PHOTOS=100
# Live Photo: только метаданные и CDN самого TikTok, без сторонних API.
TIKTOK_LIVE_PHOTOS=true
MIN_FREE_DISK_MB=1024
CACHE_MAX_MB=5120
CACHE_TTL_HOURS=72
JOB_RETENTION_DAYS=7

# Пустой список: группы выключены, администратор может включить /enable.
ALLOWED_GROUP_IDS=
ENABLE_BUSINESS=true
# Пустой список: использовать выбор переписок в настройках подключения Telegram.
BUSINESS_ALLOWED_CHAT_IDS=

# Необязательно. Netscape cookie jar для yt-dlp; не коммитить и не встраивать в образ.
COOKIES_FILE=
# Необязательно. Собственный официальный Local Bot API server для больших файлов.
BOT_API_BASE_URL=

# Mini App: HTTPS origin, no path. Empty = Telegram commands only.
ARCHIVE_PUBLIC_URL=
ARCHIVE_HOST=127.0.0.1
ARCHIVE_PORT=8080
# Local media storage budget in MiB, shared by all archive owners.
ARCHIVE_STORAGE_MB=20480
# Cloud Bot API getFile supports up to 20 decimal MB. Larger media use file_id/vault.
ARCHIVE_MEDIA_DOWNLOAD_MB=20
# Optional operator IDs. Operators see service counters, not other users' messages.
OPERATOR_IDS=
# VPS overlay only: public DNS name pointing to the VPS, without https://.
ARCHIVE_DOMAIN=
